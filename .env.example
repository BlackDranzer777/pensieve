# ---------------------------------------------------------------------------
# Pensieve — example environment. Copy to `.env` and adjust.
#   cp .env.example .env         (bash)
#   Copy-Item .env.example .env  (PowerShell)
# `.env` is gitignored. Never commit real credentials.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Host port 5433 avoids clashing with a native Postgres already on 5432.
POSTGRES_USER=pensieve
POSTGRES_PASSWORD=pensieve_local_dev
POSTGRES_DB=pensieve
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Full URL. Inside Docker Compose the host becomes `postgres` and port 5432;
# the compose file overrides this automatically.
DATABASE_URL=postgresql+psycopg://pensieve:pensieve_local_dev@localhost:5433/pensieve

# --- API ------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
LOG_LEVEL=INFO
# JSON logs are the default; set to `console` for readable local output.
LOG_FORMAT=json
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Frontend -------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# --- Data layers ----------------------------------------------------------
# Relative to the repository root unless absolute.
PENSIEVE_DATA_ROOT=data

# --- NLP ------------------------------------------------------------------
# Sentiment backend: `transformers` (real model) or `lexicon` (fast, deterministic,
# no download — used by tests and CI).
PENSIEVE_SENTIMENT_BACKEND=transformers
PENSIEVE_SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
# Faster alternative (~541 MB vs ~1.1 GB, Apache-2.0):
#   lxyuan/distilbert-base-multilingual-cased-sentiments-student
PENSIEVE_SENTIMENT_BATCH_SIZE=32
# Below this confidence, language is recorded as `unknown` rather than guessed.
PENSIEVE_LANGUAGE_MIN_CONFIDENCE=0.65

# IMPORTANT (Windows/OneDrive): keep the ~1.1 GB model cache OUT of any synced
# folder. A cache inside OneDrive causes sync churn and file-lock write errors.
HF_HOME=C:/Users/Public/pensieve/hf-cache
# macOS / Linux:
# HF_HOME=~/.cache/pensieve/hf

# --- Spark ----------------------------------------------------------------
# PySpark 4.x requires Java 17+. Run `python scripts/check_env.py` to verify.
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=8
